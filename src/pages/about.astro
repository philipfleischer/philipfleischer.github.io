---
import Layout from '../layouts/Layout.astro';

const skills = [
  {
    category: 'Security Architecture',
    icon: 'fa-shield-halved',
    items: [
      { name: 'Zero Trust', tip: 'NIST SP 800-207, the core of the Zero-Trust Continuum project' },
      { name: 'IAM & Access Control', tip: 'Policy decision and enforcement points, ABAC and trust scores (ZTC)' },
      { name: 'mTLS & PKI', tip: 'X.509 certificates and SPIFFE workload identities for services and devices (ZTC)' },
      { name: 'Threat Modelling', tip: 'STRIDE, Cyber Kill Chain and risk analysis (ZTC, TEK5520, IN2120)' },
      { name: 'MITRE ATT&CK & ATLAS', tip: 'Attack Flow of WannaCry with an ATLAS extension (TEK5520), ATT&CK for ICS in ZTC' },
      { name: 'Defence in Depth', tip: 'Layered controls, segmentation, DMZs and default deny' },
      { name: 'Cryptography & TLS', tip: 'Authentication, security protocols and network security (IN2120)' },
      { name: 'Security Trade-offs', tip: 'Weighing security against latency, availability and robustness in system design' },
    ],
  },
  {
    category: 'OT & Critical Infrastructure',
    icon: 'fa-industry',
    items: [
      { name: 'IEC 62443', tip: 'Zones, conduits and target security levels (TEK5520 and ZTC)' },
      { name: 'Purdue Model', tip: 'Levels from enterprise IT down to the process bus' },
      { name: 'ICS / SCADA Security', tip: 'How ransomware like WannaCry reaches industrial environments (TEK5520)' },
      { name: 'IEC 61850', tip: 'Substation automation, station and process bus (ZTC)' },
      { name: 'Network Segmentation', tip: 'Firewalls, VLANs and access lists between zones, OT-DMZ and jump hosts' },
    ],
  },
  {
    category: 'Cloud & Infrastructure',
    icon: 'fa-cloud',
    items: [
      { name: 'Azure', tip: 'Microsoft cloud, used with Terraform, remote state in Blob Storage' },
      { name: 'Terraform / IaC', tip: 'Providers, state, variables, modules, plan, apply and destroy' },
      { name: 'Docker & Compose', tip: 'Multi-stage images, networks, volumes, registries and health checks' },
      { name: 'Container Orchestration', tip: 'Docker Swarm labs, Kubernetes in the ZTC design' },
      { name: 'CI/CD', tip: 'GitHub Actions pipelines for this site and the ZTC project' },
      { name: 'Linux', tip: 'Daily use, shell scripting, system internals and servers' },
      { name: 'Cloud Deployment', tip: 'Apps deployed on Render, Vercel and Neon serverless Postgres' },
    ],
  },
  {
    category: 'Distributed, Fog & Edge Systems',
    icon: 'fa-diagram-project',
    items: [
      { name: 'Edge-Fog-Cloud Continuum', tip: 'Offloading, placement and cloud vs fog trade-offs (IN5700, ZTC)' },
      { name: 'Replication & Consensus', tip: 'Replicated state machines, totally ordered broadcast and Raft' },
      { name: 'Fault Tolerance', tip: 'Failure detection, resends and SWIM membership (IN5020, ZTC)' },
      { name: 'Peer-to-Peer & DHTs', tip: 'Chord ring with finger tables and consistent hashing (IN5020)' },
      { name: 'Load Balancing & Caching', tip: 'Zone-based load balancer with FIFO and LRU caching (IN5020)' },
      { name: 'Simulation & Emulation', tip: 'OMNeT++ / INET simulations and the Fogify emulator (IN5700)' },
      { name: 'Java RMI', tip: 'Distributed middleware, used for the IN5020 assignments' },
    ],
  },
  {
    category: 'Networking & Systems',
    icon: 'fa-network-wired',
    items: [
      { name: 'TCP/IP & Routing', tip: 'Designed a custom network stack with distance-vector routing (IN3230)' },
      { name: 'Network Protocols', tip: 'Sockets, HTTP, SMTP, IMAP, FTP/SFTP and TLS in Python and C' },
      { name: 'Mininet', tip: 'Emulated network topologies for testing routing (IN3230)' },
      { name: 'Wireshark', tip: 'Packet analysis and protocol debugging' },
      { name: 'Operating Systems', tip: 'Processes, memory, scheduling and concurrency (IN2140, IN3000)' },
    ],
  },
  {
    category: 'Languages',
    icon: 'fa-code',
    items: [
      { name: 'Go', tip: 'Services in the Zero-Trust Continuum project' },
      { name: 'Python', tip: 'Scripting, automation, networking tools and data analysis' },
      { name: 'Java', tip: 'Distributed systems with Java RMI and Maven (IN5020)' },
      { name: 'C / C++', tip: 'Networking and OS coursework, OMNeT++ simulation models' },
      { name: 'Bash', tip: 'Shell scripting and command-line tooling' },
      { name: 'SQL', tip: 'PostgreSQL and SQLite in several projects' },
      { name: 'TypeScript / JavaScript', tip: 'Backend services, frontends and this site' },
      { name: 'Kotlin', tip: 'Android apps in the IN2000 team projects' },
    ],
  },
  {
    category: 'Also worked with',
    icon: 'fa-wrench',
    items: [
      { name: 'Git & GitHub', tip: 'Version control, pull requests and issue tracking' },
      { name: 'Node.js / Express', tip: 'REST APIs with JWT auth and rate limiting' },
      { name: 'Kafka, Spark & Airflow', tip: 'Data engineering pipeline, all in Docker Compose' },
      { name: 'Android / Jetpack Compose', tip: 'Team apps with MVVM, both nominated among the 10 best in IN2000' },
      { name: 'pytest', tip: 'Unit testing for Python projects' },
      { name: 'Claude Code & LLM APIs', tip: 'Daily tool for design discussions and implementation, Claude, OpenAI and Gemini APIs' },
    ],
  },
];

const focus = [
  {
    icon: 'fa-book-open',
    title: 'This semester (autumn 2026)',
    items: [
      'TEK5520: Cybersecurity in Industrial Systems',
      'IN5020: Distributed Systems',
      'IN5700: Fog and Cloud Computing',
    ],
  },
  {
    icon: 'fa-compass',
    title: 'Where I am heading',
    items: [
      'Cloud and cloud security engineering, with security architecture as the long-term goal',
      'Master\'s thesis in security architecture for cloud and edge systems',
      'Applying it in sectors that matter for society, such as energy and critical infrastructure',
    ],
  },
  {
    icon: 'fa-person-running',
    title: 'Outside of studies',
    items: [
      'Training every day, mostly running and strength training',
      'Personal coding projects and keeping up with new technology',
    ],
  },
];


---

<Layout title="About - Philip Fleischer">
  <main class="page-wrapper">
    <header class="page-hero" style="padding-left:0;padding-right:0;">
      <span class="section-eyebrow">Background</span>
      <h1 class="section-title">About me</h1>
      <p class="section-subtitle">
        I'm Philip, a master's student in informatics at the University of Oslo, from Oslo. I started out with a broad interest in networks and systems, and designed and built my own network protocol stack with custom routing in one of my courses. Along the way I realised that the part I enjoy most is not writing low-level code, but thinking through how systems should be built: how access and trust are structured, which trade-offs to make between security, performance and robustness, and why things are designed the way they are.
      </p>
      <p class="section-subtitle" style="margin-top:-1.5rem">
        That is the direction I am heading: cloud, fog and edge architecture combined with security. I want to use technology, including AI, in a responsible and well-considered way, and to work on something that matters for other people and for society, like critical infrastructure. I am open to a part-time job alongside my studies, to writing my thesis together with an organisation, and to full-time roles from summer 2027.
      </p>
      <div class="about-cta">
        <a
          href="https://github.com/philipfleischer"
          class="btn-primary"
          target="_blank"
          rel="noopener"
        >
          <i class="fab fa-github fa-sm"></i> GitHub
        </a>
      </div>
    </header>

    <!-- Right now -->
    <section aria-labelledby="focus-heading">
      <h2 class="section-title" id="focus-heading">
        <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i> Right now
      </h2>
      <div class="focus-grid">
        {
          focus.map((block) => (
            <div class="skill-card">
              <h3 class="skill-card__title">
                <i class={`fa-solid ${block.icon}`} aria-hidden="true" />
                {block.title}
              </h3>
              <ul class="focus-list">
                {block.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="divider"></div>

    <!-- Skills -->
    <section aria-labelledby="skills-heading">
      <h2 class="section-title" id="skills-heading">
        <i class="fa-solid fa-layer-group" aria-hidden="true"></i> Skills
      </h2>
      <div class="skills-grid">
        {
          skills.map((group) => (
            <div class="skill-card">
              <h3 class="skill-card__title">
                <i class={`fa-solid ${group.icon}`} aria-hidden="true" />
                {group.category}
              </h3>
              <ul class="skill-tags" role="list">
                {group.items.map((item) => (
                  <li class="skill-tag" role="listitem" tabindex="0" data-tip={item.tip}>
                    {item.name}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

  </main>
</Layout>

<style lang="scss">
  @use 'src/styles/variables' as *;

  .about-cta {
    display: flex;
    gap: $sp-3;
    flex-wrap: wrap;
    margin-top: $sp-6;
  }

  // ── Right now ────────────────────────────────────────────────────
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $sp-4;
    margin-bottom: $sp-8;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }
  }

  .focus-list {
    display: grid;
    gap: $sp-2;
    padding-left: $sp-5;
    list-style: disc;
    font-size: 0.88rem;
    color: $text-muted;
    line-height: 1.6;

    li::marker { color: $accent; }
  }

  // ── Skills ───────────────────────────────────────────────────────
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: $sp-4;
    margin-bottom: $sp-8;

    @media (max-width: 720px) {
      grid-template-columns: 1fr;
    }
  }

  .skill-card {
    background: $bg-2;
    border: 1px solid $border-subtle;
    border-radius: $r-lg;
    padding: $sp-5;
    align-self: start;
  }

  .skill-card__title {
    display: flex;
    align-items: center;
    gap: $sp-3;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: $text-muted;
    margin-bottom: $sp-4;

    i {
      color: $accent;
      width: 16px;
    }
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: $sp-2;
  }

  .skill-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: $r-full;
    background: $bg-3;
    border: 1px solid $border-subtle;
    color: $text-muted;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: default;
    user-select: none;
    transition:
      border-color $t-fast $ease,
      color $t-fast $ease,
      transform $t-fast $ease;

    &:hover,
    &:focus {
      border-color: $accent;
      color: $text;
      transform: translateY(-1px);
      outline: none;
    }

    // Tooltip
    &[data-tip]::after {
      content: attr(data-tip);
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%) translateY(4px);
      background: $bg-3;
      color: $text-muted;
      border: 1px solid $border;
      border-radius: $r;
      padding: 0.4rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1.3;
      white-space: normal;
      width: max-content;
      max-width: 240px;
      opacity: 0;
      pointer-events: none;
      z-index: 999;
      transition:
        opacity $t-fast $ease,
        transform $t-fast $ease;
    }

    &:hover::after,
    &:focus::after {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    // Hidden tooltips near the screen edge widen the page on phones,
    // and there is no hover on touch screens anyway
    @media (max-width: 720px) {
      &[data-tip]::after { display: none; }
    }
  }

</style>
