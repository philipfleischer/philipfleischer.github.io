---
import Layout from '../layouts/Layout.astro';

const skills = [
  {
    category: 'Security & Architecture',
    icon: 'fa-shield-halved',
    items: [
      { name: 'Zero Trust', tip: 'NIST SP 800-207, applied in the Zero-Trust Continuum project' },
      { name: 'IAM & Access Control', tip: 'Identity, policy decision and enforcement points, credential models' },
      { name: 'System Design', tip: 'Layered architecture and trade-offs between security, performance and robustness' },
      { name: 'Threat Modelling', tip: 'Cyber Kill Chain and risk analysis, e.g. the WannaCry report' },
      { name: 'Defence in Depth', tip: 'Layered controls, segmentation and industrial DMZs' },
      { name: 'IEC 62443', tip: 'Zones, conduits and the Purdue model for industrial systems (TEK5520)' },
    ],
  },
  {
    category: 'Cloud, Fog & Distributed Systems',
    icon: 'fa-cloud',
    items: [
      { name: 'Azure', tip: 'Microsoft cloud, basic, used in a Terraform lab' },
      { name: 'Terraform', tip: 'Infrastructure as code, basic, used with Azure' },
      { name: 'Docker', tip: 'Multi-stage images and Compose deployments with health checks' },
      { name: 'Fog & Edge Computing', tip: 'Offloading, placement and the edge-fog-cloud continuum (IN5700)' },
      { name: 'Replication & Consensus', tip: 'Replicated state machines, ordered broadcast, Raft and Chord' },
      { name: 'Load Balancing & Caching', tip: 'Zone-based load balancer with FIFO and LRU caching (IN5020)' },
      { name: 'Java RMI', tip: 'Distributed middleware, used for the IN5020 assignments' },
      { name: 'OMNeT++ / INET', tip: 'Network and fog simulation, used for the IN5700 group project' },
    ],
  },
  {
    category: 'Systems & Networking',
    icon: 'fa-network-wired',
    items: [
      { name: 'TCP/IP & Routing', tip: 'Designed a custom network stack with distance-vector routing (IN3230)' },
      { name: 'Linux', tip: 'Daily use, shell scripting and system internals' },
      { name: 'Bash', tip: 'Shell scripting and command-line tooling' },
      { name: 'Wireshark', tip: 'Packet analysis and protocol debugging' },
      { name: 'Operating Systems', tip: 'Processes, memory and scheduling (IN3000)' },
    ],
  },
  {
    category: 'Languages',
    icon: 'fa-code',
    items: [
      { name: 'Go', tip: 'Services in the Zero-Trust Continuum project' },
      { name: 'Python', tip: 'Scripting, data analysis, ML and plotting' },
      { name: 'Java', tip: 'Object-oriented programming and Java RMI' },
      { name: 'C / C++', tip: 'Networking and OS coursework, OMNeT++ simulation models' },
      { name: 'JavaScript / TypeScript', tip: 'Frontend, backend and this site' },
      { name: 'Kotlin', tip: 'Android development and course projects' },
    ],
  },
  {
    category: 'Tooling & Practices',
    icon: 'fa-wrench',
    items: [
      { name: 'GitHub Actions', tip: 'CI/CD, set up for this site and the ZTC project' },
      { name: 'Git & GitHub', tip: 'Version control, pull requests and issue tracking' },
      { name: 'Maven', tip: 'Java builds for the IN5020 assignments' },
      { name: 'pytest', tip: 'Unit testing for Python projects' },
    ],
  },
  {
    category: 'Web, Backend & Mobile',
    icon: 'fa-globe',
    items: [
      { name: 'Node.js / Express', tip: 'REST API development' },
      { name: 'PostgreSQL', tip: 'Relational database and SQL' },
      { name: 'React', tip: 'Component-based UI, basic experience' },
      { name: 'MongoDB', tip: 'NoSQL, used in MERN stack projects' },
      { name: 'Android / Jetpack Compose', tip: 'Native Android apps with MVVM and Clean Architecture' },
    ],
  },
  {
    category: 'AI & APIs',
    icon: 'fa-robot',
    items: [
      { name: 'Claude & Claude Code', tip: 'Daily tool for design discussions and implementation' },
      { name: 'Anthropic API', tip: 'Claude API, personal projects' },
      { name: 'OpenAI API', tip: 'Built projects integrating GPT models' },
      { name: 'Prompt Engineering', tip: '2+ years of daily use of AI tools in development' },
    ],
  },
];

const focus = [
  {
    icon: 'fa-book-open',
    title: 'This semester (autumn 2026)',
    items: [
      'TEK5520: Cybersecurity in Industrial Systems',
      'IN5020: Distributed Systems',
      'IN5700: Fog and Cloud Computing',
    ],
  },
  {
    icon: 'fa-compass',
    title: 'Where I am heading',
    items: [
      'Cloud and cloud security engineering, with security architecture as the long-term goal',
      'Master\'s thesis in security architecture for cloud and edge systems',
      'Applying it in sectors that matter for society, such as energy and critical infrastructure',
    ],
  },
  {
    icon: 'fa-person-running',
    title: 'Outside of studies',
    items: [
      'Training every day, mostly running and strength training',
      'Personal coding projects and keeping up with new technology',
      'Weekly part-time job in building operations and maintenance',
    ],
  },
];

const education = [
  {
    icon: 'fa-graduation-cap',
    period: '2026 - Present',
    title: 'University of Oslo',
    sub: 'MSc Informatics, Programming and System Architecture',
    desc: "Master's degree with a focus on cloud, fog and edge architecture and security. I am currently looking for a thesis topic within security architecture for cloud and edge systems, and I am open to writing it in collaboration with an organisation.",
  },
  {
    icon: 'fa-graduation-cap',
    period: '2026',
    title: 'University of Oslo',
    sub: 'BSc Informatics, Programming and System Architecture',
    desc: "Completed in June 2026. Courses include networks (IN3230), information security (IN2120), operating systems (IN3000), algorithms (IN3130), software engineering in teams (IN2000) and machine learning (IN1160).",
  },
  {
    icon: 'fa-compass',
    period: '2023 - 2024',
    title: 'Study break',
    sub: 'Economics, management and astrophysics',
    desc: 'Took time to try courses in economics, management and astrophysics to see if another field suited me better. It confirmed that informatics was the right choice, and my progress and grades have been clearly stronger since I came back.',
  },
  {
    icon: 'fa-school',
    period: '2018 - 2021',
    title: 'Foss High School',
    sub: 'General Studies',
    desc: 'General academic studies. Took part in academic summer programmes, including nanotechnology at the University of Oslo.',
  },
];

const work = [
  {
    icon: 'fa-leaf',
    period: 'Jun 2025 - Present',
    title: 'Housing Cooperative (Sameie), Oslo',
    sub: 'Operations & Maintenance Worker',
    desc: 'Part-time job alongside my studies, every week all year round: general upkeep, repairs and seasonal work on the property.',
  },
  {
    icon: 'fa-wine-glass',
    period: 'Jun 2021 - Sep 2022',
    title: 'Nektar Vinbar',
    sub: 'Kitchen & Cleaning Support',
    desc: 'Dishwashing during weekend service and responsible for cleaning the venue on Sundays.',
  },
  {
    icon: 'fa-mug-hot',
    period: 'Mar 2018 - Sep 2018',
    title: 'Blafre Café',
    sub: 'Café Employee / Barista',
    desc: 'Prepared food and coffee, handled cash register, inventory, and daily operations.',
  },
  {
    icon: 'fa-table-tennis-paddle-ball',
    period: 'Jan 2014 - Jan 2015',
    title: 'Grefsen Tennisklubb',
    sub: 'Tennis Instructor',
    desc: 'Coached children and young players twice a week and planned training sessions focused on progress and enjoyment.',
  },
];
---

<Layout title="About - Philip Fleischer">
  <main class="page-wrapper">
    <header class="page-hero" style="padding-left:0;padding-right:0;">
      <span class="section-eyebrow">Background</span>
      <h1 class="section-title">About me</h1>
      <p class="section-subtitle">
        I'm Philip, a master's student in informatics at the University of Oslo, from Oslo. I started out with a broad interest in networks and systems, and designed and built my own network protocol stack with custom routing in one of my courses. Along the way I realised that the part I enjoy most is not writing low-level code, but thinking through how systems should be built: how access and trust are structured, which trade-offs to make between security, performance and robustness, and why things are designed the way they are.
      </p>
      <p class="section-subtitle" style="margin-top:-1.5rem">
        That is the direction I am heading: cloud, fog and edge architecture combined with security. I want to use technology, including AI, in a responsible and well-considered way, and to work on something that matters for other people and for society, like critical infrastructure. I am open to a part-time job alongside my studies, to writing my thesis together with an organisation, and to full-time roles from summer 2027.
      </p>
      <div class="about-cta">
        <a
          href="https://github.com/philipfleischer"
          class="btn-primary"
          target="_blank"
          rel="noopener"
        >
          <i class="fab fa-github fa-sm"></i> GitHub
        </a>
      </div>
    </header>

    <!-- Right now -->
    <section aria-labelledby="focus-heading">
      <h2 class="section-title" id="focus-heading">
        <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i> Right now
      </h2>
      <div class="focus-grid">
        {
          focus.map((block) => (
            <div class="skill-card">
              <h3 class="skill-card__title">
                <i class={`fa-solid ${block.icon}`} aria-hidden="true" />
                {block.title}
              </h3>
              <ul class="focus-list">
                {block.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="divider"></div>

    <!-- Skills -->
    <section aria-labelledby="skills-heading">
      <h2 class="section-title" id="skills-heading">
        <i class="fa-solid fa-layer-group" aria-hidden="true"></i> Skills
      </h2>
      <div class="skills-grid">
        {
          skills.map((group) => (
            <div class="skill-card">
              <h3 class="skill-card__title">
                <i class={`fa-solid ${group.icon}`} aria-hidden="true" />
                {group.category}
              </h3>
              <ul class="skill-tags" role="list">
                {group.items.map((item) => (
                  <li class="skill-tag" role="listitem" tabindex="0" data-tip={item.tip}>
                    {item.name}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="divider"></div>

    <!-- Timeline -->
    <section aria-labelledby="timeline-heading">
      <h2 class="section-title" id="timeline-heading">
        <i class="fa-solid fa-timeline" aria-hidden="true"></i> Timeline
      </h2>

      <h3 class="timeline-group">Education</h3>
      <div class="timeline">
        {
          education.map((item) => (
            <div class="tl-item">
              <div class="tl-icon">
                <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
              </div>
              <div class="tl-body">
                <span class="tl-period">{item.period}</span>
                <h4 class="tl-title">
                  {item.title} <span class="tl-sub">- {item.sub}</span>
                </h4>
                <p class="tl-desc">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="timeline-group">Work Experience</h3>
      <div class="timeline">
        {
          work.map((item) => (
            <div class="tl-item">
              <div class="tl-icon">
                <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
              </div>
              <div class="tl-body">
                <span class="tl-period">{item.period}</span>
                <h4 class="tl-title">
                  {item.title} <span class="tl-sub">- {item.sub}</span>
                </h4>
                <p class="tl-desc">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style lang="scss">
  @use 'src/styles/variables' as *;

  .about-cta {
    display: flex;
    gap: $sp-3;
    flex-wrap: wrap;
    margin-top: $sp-6;
  }

  // ── Right now ────────────────────────────────────────────────────
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $sp-4;
    margin-bottom: $sp-8;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }
  }

  .focus-list {
    display: grid;
    gap: $sp-2;
    padding-left: $sp-5;
    list-style: disc;
    font-size: 0.88rem;
    color: $text-muted;
    line-height: 1.6;

    li::marker { color: $accent; }
  }

  // ── Skills ───────────────────────────────────────────────────────
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: $sp-4;
    margin-bottom: $sp-8;

    @media (max-width: 720px) {
      grid-template-columns: 1fr;
    }
  }

  .skill-card {
    background: $bg-2;
    border: 1px solid $border-subtle;
    border-radius: $r-lg;
    padding: $sp-5;
    align-self: start;
  }

  .skill-card__title {
    display: flex;
    align-items: center;
    gap: $sp-3;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: $text-muted;
    margin-bottom: $sp-4;

    i {
      color: $accent;
      width: 16px;
    }
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: $sp-2;
  }

  .skill-tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: $r-full;
    background: $bg-3;
    border: 1px solid $border-subtle;
    color: $text-muted;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: default;
    user-select: none;
    transition:
      border-color $t-fast $ease,
      color $t-fast $ease,
      transform $t-fast $ease;

    &:hover,
    &:focus {
      border-color: $accent;
      color: $text;
      transform: translateY(-1px);
      outline: none;
    }

    // Tooltip
    &[data-tip]::after {
      content: attr(data-tip);
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%) translateY(4px);
      background: $bg-3;
      color: $text-muted;
      border: 1px solid $border;
      border-radius: $r;
      padding: 0.4rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1.3;
      white-space: normal;
      width: max-content;
      max-width: 240px;
      opacity: 0;
      pointer-events: none;
      z-index: 999;
      transition:
        opacity $t-fast $ease,
        transform $t-fast $ease;
    }

    &:hover::after,
    &:focus::after {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    // Hidden tooltips near the screen edge widen the page on phones,
    // and there is no hover on touch screens anyway
    @media (max-width: 720px) {
      &[data-tip]::after { display: none; }
    }
  }

  // ── Timeline ─────────────────────────────────────────────────────
  .timeline-group {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: $accent;
    margin: $sp-8 0 $sp-5;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: $sp-5;
    margin-bottom: $sp-8;

    @media (max-width: 720px) {
      grid-template-columns: 1fr;
    }
  }

  .tl-item {
    display: flex;
    gap: $sp-4;
  }

  .tl-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: $r-full;
    background: $accent-subtle;
    border: 1px solid $accent;
    display: flex;
    align-items: center;
    justify-content: center;

    i {
      font-size: 0.9rem;
      color: $accent;
    }
  }

  .tl-body {
    flex: 1;
  }

  .tl-period {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: $text-dim;
    background: $bg-3;
    border-radius: $r-full;
    padding: 0.2rem 0.6rem;
    margin-bottom: $sp-2;
  }

  .tl-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: $text;
    margin-bottom: $sp-2;
  }

  .tl-sub {
    font-weight: 500;
    color: $text-muted;
    font-size: 0.88rem;
  }

  .tl-desc {
    font-size: 0.88rem;
    color: $text-dim;
    line-height: 1.6;
  }
</style>
